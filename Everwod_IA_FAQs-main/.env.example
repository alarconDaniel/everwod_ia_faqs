# ============================================================
# DATABASE CONFIGURATION
# ============================================================

DB_NAME=everwod_faq_mvp
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Schema used by the FAQ MVP module
FAQ_SCHEMA=faq_mvp


# ============================================================
# CORS CONFIGURATION
# ============================================================

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ============================================================
# CLEANING / LANGUAGE
# ============================================================

FAQ_CLEANING_ENABLED=true
FAQ_STRIP_EMOJIS=true
FAQ_STRIP_URLS=true
FAQ_SUPPORTED_LANGUAGES=es,en


# ============================================================
# EMBEDDINGS CONFIGURATION
# ============================================================

FAQ_EMBEDDING_BACKEND=sentence-transformers
FAQ_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Used only if the hash embedding backend is selected
FAQ_HASH_EMBEDDING_DIM=96


# ============================================================
# CANDIDATE HARVESTING
# ============================================================

FAQ_CANDIDATE_HARVEST_MODE=broad

# Safety limit for full analysis runs
FAQ_SAFE_FULL_ANALYSIS_LIMIT=50000


# ============================================================
# CLUSTERING CONFIGURATION
# ============================================================

FAQ_CLUSTER_ALGORITHM=auto
FAQ_CLUSTER_EPS=0.28

FAQ_MIN_CLUSTER_SIZE=3
FAQ_MIN_CLUSTER_SUPPORT=0.50
FAQ_MIN_CLUSTER_COHESION=0.45

# HDBSCAN-specific parameters
FAQ_HDBSCAN_MIN_CLUSTER_SIZE=3
FAQ_HDBSCAN_MIN_SAMPLES=2

# Allows clusters with only two examples if they are very cohesive
FAQ_ALLOW_TWO_EXAMPLE_CLUSTERS=true
FAQ_TWO_EXAMPLE_MIN_COHESION=0.74

# Enables fallback logic when normal clustering is not enough
FAQ_ENABLE_HIERARCHICAL_FALLBACK=true


# ============================================================
# HUMAN-IN-THE-LOOP / DEDUPLICATION
# ============================================================

FAQ_SKIP_EXISTING=true
FAQ_SKIP_REJECTED=true

# Active threshold: stricter duplicate detection
FAQ_DUPLICATE_THRESHOLD=0.84

# Previous softer threshold, useful if too many similar FAQs pass through
# FAQ_DUPLICATE_THRESHOLD=0.78


# ============================================================
# FAQ GENERATION CONFIDENCE
# ============================================================

FAQ_MIN_GENERATION_CONFIDENCE=0.35


# ============================================================
# SCHEDULED EXECUTION
# ============================================================

# Monthly execution
FAQ_SCHEDULE_INTERVAL_DAYS=30
FAQ_SCHEDULE_SINCE_DAYS=365

# Maximum number of records to process per scheduled run.
# Leave empty for no explicit limit.
FAQ_SCHEDULE_LIMIT=

# Previous weekly execution configuration
# FAQ_SCHEDULE_INTERVAL_DAYS=7
# FAQ_SCHEDULE_SINCE_DAYS=90
# FAQ_SCHEDULE_LIMIT=15000


# ============================================================
# LLM CONFIGURATION
# ============================================================

FAQ_LLM_ENABLED=true
FAQ_LLM_MODEL=Qwen/Qwen3-1.7B

# Alternative lighter model
# FAQ_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Device options:
# - cpu: safest if you do not have GPU/CUDA configured
# - auto: lets the backend decide automatically
FAQ_LLM_DEVICE=cpu
# FAQ_LLM_DEVICE=auto

FAQ_LLM_TORCH_DTYPE=auto